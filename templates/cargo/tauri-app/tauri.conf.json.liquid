{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{app_name}}",
  "version": "0.1.0",
  "identifier": "{{org_identifier}}.{{app_name}}",
  "build": {
    "beforeDevCommand": "npm -w @YOUR_SCOPE/{{app_name}} run dev",
    "devUrl": "http://localhost:{{dev_port}}",
    "beforeBuildCommand": "npm -w @YOUR_SCOPE/{{app_name}} run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "{{app_name}}-main",
        "title": "{{app_name}}",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
