{
  "name": "<%= workspaceName %>",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:terminal",
    "dev:terminal": "npm -w @<%= orgScope %>/one-terminal run tauri:dev",
    "build:terminal": "npm -w @<%= orgScope %>/one-terminal run tauri:build",
    "dev:vite:terminal": "npm -w @<%= orgScope %>/one-terminal run dev",
    "dev:sample-widget": "npm -w @<%= orgScope %>/sample-widget run dev",
    "create-widget": "node scripts/new-widget.mjs",
    "build": "npm run build:terminal",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fmt:rust": "cargo fmt --all",
    "lint:rust": "cargo fmt --check --all"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lightningcss": "^1.32.0",
    "prettier": "^3.8.3",
    "rolldown": "1.0.3",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.59.2"
  }
}
