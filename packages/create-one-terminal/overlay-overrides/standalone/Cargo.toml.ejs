[workspace]
resolver = "2"
members = [
    "apps/one-terminal/src-tauri",
    "packages/ot-core",
    "packages/ot-telemetry",
]

# ── Shared dependency versions ────────────────────────────────────────────────
# Add new apps/packages here and reference these via `{ workspace = true }`.
[workspace.dependencies]
# Serialisation
serde     = { version = "1",      features = ["derive"] }
serde_json = "1"

# Async runtime
tokio = { version = "1.50.0", features = ["full"] }

# Tauri
tauri              = { version = "2", features = ["unstable"] }

# Concurrency
indexmap = { version = "2", features = ["serde"] }

# Async helpers
futures-util      = "0.3"

# HTTP client (Terminal uses it for engine downloads + optional widget registry fetch)
reqwest = { version = "0.12", default-features = false, features = ["json", "rustls-tls", "stream"] }

# Engine runtime cache (download/verify/extract)
sha2 = "0.10"
hex  = "0.4"
# Widget telemetry endpoint (packages/ot-telemetry, feature `ingress`).
hmac = "0.12"
rand = "0.8"
axum = { version = "0.7", features = ["ws"] }
zip  = { version = "9.6", default-features = false, features = ["deflate-flate2-zlib-rs"] }

# Logging, tracing and OpenTelemetry (packages/ot-telemetry). The opentelemetry*
# crates move together: same minor for all of them, tracing-opentelemetry one higher.
# tracing-subscriber without `env-filter`: its regex engine adds ~1 MB to every
# binary; ot-telemetry filters with the regex-free `Targets` instead.
tracing            = "0.1"
tracing-subscriber = { version = "0.3", default-features = false, features = ["std", "fmt", "ansi", "json", "registry", "tracing-log", "smallvec"] }
tracing-appender   = "0.2"
tracing-log        = { version = "0.2", default-features = false, features = ["std"] }
opentelemetry      = { version = "0.33", default-features = false, features = ["trace", "metrics", "logs"] }
opentelemetry_sdk  = { version = "0.33", default-features = false, features = ["trace", "metrics", "logs"] }
# No built-in HTTP client: ot-telemetry plugs in the workspace's reqwest 0.12.
opentelemetry-otlp = { version = "0.33", default-features = false, features = ["http-proto", "trace", "metrics", "logs"] }
opentelemetry-http = { version = "0.33", default-features = false }
async-trait        = "0.1"
tracing-opentelemetry          = { version = "0.34", default-features = false }
opentelemetry-appender-tracing = { version = "0.33", default-features = false }

# Internal crates
ot-core = { path = "packages/ot-core" }
ot-telemetry = { path = "packages/ot-telemetry", default-features = false }

# ── Lints ─────────────────────────────────────────────────────────────────────
# Inherited by every member with `[lints] workspace = true`. CI runs Clippy with
# `-D warnings`, so "warn" fails CI while still letting local drafts compile.
# Rationale and the lints deliberately left off: docs/conventions/rust.md (Tooling).
[workspace.lints.rust]
unsafe_code = "forbid"

[workspace.lints.clippy]
# Never ship debugging leftovers or placeholders.
dbg_macro = "warn"
todo = "warn"
unimplemented = "warn"
undocumented_unsafe_blocks = "warn"
# Clarity: explicit `Arc::clone(&x)`, no hidden clones, let-else for early returns.
clone_on_ref_ptr = "warn"
implicit_clone = "warn"
manual_let_else = "warn"
semicolon_if_nothing_returned = "warn"
uninlined_format_args = "warn"
