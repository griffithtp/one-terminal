[workspace]
resolver = "2"
members = [
    "apps/one-terminal/src-tauri",
    "packages/ot-core",
]

# ── Shared dependency versions ────────────────────────────────────────────────
# Add new apps/packages here and reference these via `{ workspace = true }`.
[workspace.dependencies]
# Serialisation
serde     = { version = "1",      features = ["derive"] }
serde_json = "1"

# Async runtime
tokio = { version = "1.50.0", features = ["full"] }

# Tauri
tauri              = { version = "2", features = ["unstable"] }

# Concurrency
indexmap = { version = "2", features = ["serde"] }

# Async helpers
futures-util      = "0.3"

# HTTP client (Terminal uses it for engine downloads + optional widget registry fetch)
reqwest = { version = "0.12", default-features = false, features = ["json", "rustls-tls", "stream"] }

# Engine runtime cache (download/verify/extract)
sha2 = "0.10"
hex  = "0.4"
zip  = { version = "9.6", default-features = false, features = ["deflate-flate2-zlib-rs"] }

# Internal crates
ot-core = { path = "packages/ot-core" }

# ── Lints ─────────────────────────────────────────────────────────────────────
# Inherited by every member with `[lints] workspace = true`. CI runs Clippy with
# `-D warnings`, so "warn" fails CI while still letting local drafts compile.
# Rationale and the lints deliberately left off: docs/conventions/rust.md (Tooling).
[workspace.lints.rust]
unsafe_code = "forbid"

[workspace.lints.clippy]
# Never ship debugging leftovers or placeholders.
dbg_macro = "warn"
todo = "warn"
unimplemented = "warn"
undocumented_unsafe_blocks = "warn"
# Clarity: explicit `Arc::clone(&x)`, no hidden clones, let-else for early returns.
clone_on_ref_ptr = "warn"
implicit_clone = "warn"
manual_let_else = "warn"
semicolon_if_nothing_returned = "warn"
uninlined_format_args = "warn"
