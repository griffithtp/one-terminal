{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "<%= workspaceName %>-terminal",
  "version": "0.1.0",
  "identifier": "<%= tauriIdentifier %>.terminal",
  "build": {
    "beforeDevCommand": "npm -w @<%= orgScope %>/one-terminal run dev",
    "devUrl": "http://localhost:<%= terminalDevPort %>",
    "beforeBuildCommand": "npm -w @<%= orgScope %>/one-terminal run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
