interface Props {
  log: string[];
}

export function ActivityFeed({ log }: Props) {
  return (
    <section className="panel panel--full">
      <h2 className="panel__title">
        Activity Feed
        <span className="panel__badge">{log.length}</span>
      </h2>
      <div className="activity-feed">
        {log.length === 0 ? (
          <p className="panel__empty">No events yet.</p>
        ) : (
          log.map((entry, i) => (
            <div key={i} className="activity-feed__entry">
              {entry}
            </div>
          ))
        )}
      </div>
    </section>
  );
}
