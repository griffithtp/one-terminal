export function getCatalog(): EngineCatalog {
  return catalog;
}

export function isEngineBindingValid(
  os: keyof EngineCatalog,
  family: string,
  version: string
): boolean {
  const entries = catalog[os] ?? [];
  return entries.some((e) => e.family === family && e.version === version);
}
