<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ticker-Plant</title>
  <style>
    :root {
      --bg:      #0d1117;
      --surface: #161b22;
      --border:  #30363d;
      --text:    #e6edf3;
      --muted:   #8b949e;
      --accent:  #388bfd;
      --green:   #3fb950;
      --red:     #f85149;
      --amber:   #f0a040;
      --radius:  6px;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: ui-monospace, "Cascadia Code", "Fira Code", monospace;
      font-size: 13px;
      min-height: 100vh;
    }

    /* ── Header ── */
    header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 12px 20px;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .app-name  { font-weight: 700; font-size: 15px; }
    .app-badge {
      font-size: 10px;
      background: rgba(56,139,253,0.15);
      color: var(--accent);
      border: 1px solid rgba(56,139,253,0.3);
      border-radius: 10px;
      padding: 2px 8px;
    }
    #status {
      margin-left: auto;
      font-size: 11px;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    #status-dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      background: var(--muted);
      flex-shrink: 0;
    }
    #status-dot.connected  { background: var(--green); box-shadow: 0 0 6px var(--green); }
    #status-dot.error      { background: var(--red); }

    /* ── Main layout ── */
    main { padding: 16px 20px; display: flex; flex-direction: column; gap: 16px; }

    /* ── Channel row ── */
    .channel-row {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
    }
    .channel-row label { color: var(--muted); }
    #channel-select {
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: var(--radius);
      padding: 4px 10px;
      font-family: inherit;
      font-size: 12px;
      cursor: pointer;
    }
    .join-btn {
      background: none;
      border: 1px solid var(--accent);
      color: var(--accent);
      border-radius: var(--radius);
      padding: 4px 12px;
      cursor: pointer;
      font-size: 12px;
      font-family: inherit;
    }
    .join-btn:hover { background: rgba(56,139,253,0.1); }
    #channel-indicator {
      font-size: 11px;
      color: var(--green);
      display: none;
    }

    /* ── Rates table ── */
    .section-title {
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 8px;
    }
    table { width: 100%; border-collapse: collapse; }
    thead th {
      text-align: left;
      font-size: 11px;
      color: var(--muted);
      padding: 6px 10px;
      border-bottom: 1px solid var(--border);
      font-weight: 500;
    }
    tbody tr {
      border-bottom: 1px solid rgba(48,54,61,0.5);
      transition: background 0.1s;
      cursor: pointer;
    }
    tbody tr:hover { background: rgba(255,255,255,0.04); }
    tbody tr.flash-up   { background: rgba(63,185,80,0.12); }
    tbody tr.flash-down { background: rgba(248,81,73,0.12); }
    td { padding: 8px 10px; }
    .td-symbol { font-weight: 600; color: var(--text); }
    .td-bid, .td-ask { color: var(--muted); font-variant-numeric: tabular-nums; }
    .td-bid.up, .td-ask.up   { color: var(--green); }
    .td-bid.down, .td-ask.down { color: var(--red); }
    .td-spread { color: var(--muted); font-size: 11px; }
    .td-actions { text-align: right; }

    /* ── Action buttons ── */
    .btn {
      background: none;
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: var(--radius);
      padding: 3px 9px;
      cursor: pointer;
      font-size: 11px;
      font-family: inherit;
      transition: border-color 0.1s, background 0.1s;
    }
    .btn:hover { background: rgba(255,255,255,0.05); border-color: var(--muted); }
    .btn--broadcast { color: var(--accent); border-color: rgba(56,139,253,0.4); }
    .btn--broadcast:hover { background: rgba(56,139,253,0.1); border-color: var(--accent); }
    .btn--intent    { color: var(--green); border-color: rgba(63,185,80,0.4); }
    .btn--intent:hover    { background: rgba(63,185,80,0.1); border-color: var(--green); }

    /* ── Activity log ── */
    #log {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 10px 12px;
      max-height: 140px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .log-entry {
      font-size: 11px;
      color: var(--muted);
      line-height: 1.4;
    }
    .log-entry .ts  { color: rgba(139,148,158,0.6); margin-right: 6px; }
    .log-entry .ok  { color: var(--green); margin-right: 4px; }
    .log-entry .err { color: var(--red);   margin-right: 4px; }
    .log-entry .sym { color: var(--accent); }
  </style>
</head>
<body>

<header>
  <span class="app-name">Ticker-Plant</span>
  <span class="app-badge">FDC3 2.2</span>
  <div id="status">
    <span id="status-dot"></span>
    <span id="status-text">Connecting…</span>
  </div>
</header>

<main>

  <!-- Channel selector -->
  <div class="channel-row">
    <label>Channel</label>
    <select id="channel-select"><option value="">— pick —</option></select>
    <button class="join-btn" id="join-btn">Join</button>
    <span id="channel-indicator"></span>
  </div>

  <!-- Rates table -->
  <div>
    <div class="section-title">FX Spot Rates</div>
    <table>
      <thead>
        <tr>
          <th>Symbol</th>
          <th>Bid</th>
          <th>Ask</th>
          <th>Spread</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="rates-body"></tbody>
    </table>
  </div>

  <!-- Activity log -->
  <div>
    <div class="section-title">Activity</div>
    <div id="log"><div class="log-entry"><span class="ts">--:--:--</span>Waiting for CDA connection…</div></div>
  </div>

</main>

<script type="module">
import { DesktopAgentClient } from '/fdc3-plugin.js';

// ── Mock rate data ──────────────────────────────────────────────────────────

const PAIRS = [
  { symbol: 'EUR/USD', mid: 1.08420, pip: 0.0001, digits: 5 },
  { symbol: 'GBP/USD', mid: 1.26710, pip: 0.0001, digits: 5 },
  { symbol: 'USD/JPY', mid: 149.820, pip: 0.01,   digits: 3 },
  { symbol: 'AUD/USD', mid: 0.64350, pip: 0.0001, digits: 5 },
  { symbol: 'USD/CHF', mid: 0.89950, pip: 0.0001, digits: 5 },
  { symbol: 'EUR/GBP', mid: 0.85620, pip: 0.0001, digits: 5 },
];

// Live rate state
const rates = {};
for (const p of PAIRS) {
  const spread = p.pip * (p.symbol.includes('JPY') ? 2 : 1.5);
  rates[p.symbol] = {
    ...p,
    bid: +(p.mid - spread / 2).toFixed(p.digits),
    ask: +(p.mid + spread / 2).toFixed(p.digits),
    dir: 0,
  };
}

// ── DOM helpers ─────────────────────────────────────────────────────────────

const statusDot  = document.getElementById('status-dot');
const statusText = document.getElementById('status-text');
const logEl      = document.getElementById('log');
const channelSel = document.getElementById('channel-select');
const joinBtn    = document.getElementById('join-btn');
const chanInd    = document.getElementById('channel-indicator');
const ratesBody  = document.getElementById('rates-body');

function setStatus(text, cls) {
  statusText.textContent = text;
  statusDot.className = cls ?? '';
}

function addLog(icon, msg, symClass) {
  const ts  = new Date().toTimeString().slice(0, 8);
  const el  = document.createElement('div');
  el.className = 'log-entry';
  el.innerHTML =
    `<span class="ts">${ts}</span>` +
    `<span class="${icon === '✓' ? 'ok' : 'err'}">${icon}</span>` +
    (symClass
      ? msg.replace(/\[(.+?)\]/, '<span class="sym">[$1]</span>')
      : msg);
  logEl.prepend(el);
  while (logEl.children.length > 40) logEl.removeChild(logEl.lastChild);
}

// ── Table rendering ──────────────────────────────────────────────────────────

function formatRate(val, digits) {
  return val.toFixed(digits);
}

function buildRows() {
  ratesBody.innerHTML = '';
  for (const p of PAIRS) {
    const tr = document.createElement('tr');
    tr.dataset.symbol = p.symbol;
    tr.innerHTML = `
      <td class="td-symbol">${p.symbol}</td>
      <td class="td-bid">${formatRate(rates[p.symbol].bid, p.digits)}</td>
      <td class="td-ask">${formatRate(rates[p.symbol].ask, p.digits)}</td>
      <td class="td-spread">${(rates[p.symbol].ask - rates[p.symbol].bid).toFixed(p.digits)}</td>
      <td class="td-actions">
        <button class="btn btn--broadcast" data-sym="${p.symbol}" data-action="broadcast">Broadcast</button>
        <button class="btn btn--intent"    data-sym="${p.symbol}" data-action="intent">ViewChart ↗</button>
      </td>`;
    ratesBody.appendChild(tr);
  }
}

function flashRow(symbol, dir) {
  const tr = ratesBody.querySelector(`[data-symbol="${symbol}"]`);
  if (!tr) return;
  const cls = dir > 0 ? 'flash-up' : 'flash-down';
  tr.classList.add(cls);
  tr.querySelector('.td-bid').className = `td-bid ${dir > 0 ? 'up' : 'down'}`;
  tr.querySelector('.td-ask').className = `td-ask ${dir > 0 ? 'up' : 'down'}`;
  setTimeout(() => {
    tr.classList.remove(cls);
    tr.querySelector('.td-bid').className = 'td-bid';
    tr.querySelector('.td-ask').className = 'td-ask';
  }, 800);
}

function updateRow(symbol) {
  const r  = rates[symbol];
  const tr = ratesBody.querySelector(`[data-symbol="${symbol}"]`);
  if (!tr) return;
  tr.cells[1].textContent = formatRate(r.bid, r.digits);
  tr.cells[2].textContent = formatRate(r.ask, r.digits);
  tr.cells[3].textContent = (r.ask - r.bid).toFixed(r.digits);
}

// ── Tick simulation ──────────────────────────────────────────────────────────

function tick() {
  for (const sym of Object.keys(rates)) {
    const r = rates[sym];
    if (Math.random() < 0.3) continue;           // only ~70 % of pairs move each tick
    const move  = (Math.random() - 0.5) * r.pip * 4;
    const dir   = move > 0 ? 1 : -1;
    r.mid  = +(r.mid + move).toFixed(r.digits);
    const spread = r.pip * (sym.includes('JPY') ? 2 : 1.5);
    r.bid  = +(r.mid - spread / 2).toFixed(r.digits);
    r.ask  = +(r.mid + spread / 2).toFixed(r.digits);
    r.dir  = dir;
    updateRow(sym);
    flashRow(sym, dir);
  }
}

setInterval(tick, 500);
buildRows();

// ── FDC3 initialisation ──────────────────────────────────────────────────────

let fdc3 = null;
let currentChannel = null;

setStatus('Connecting to CDA…', '');

try {
  fdc3 = await DesktopAgentClient.connect('ticker-plant');
  setStatus(`Connected  ·  instance: ${fdc3.getIdentity().instanceId.slice(0, 8)}`, 'connected');
  addLog('✓', 'Connected to CDA hub');

  // Populate channel selector from the welcome message
  const channels = await fdc3.getUserChannels();
  for (const ch of channels) {
    const opt = document.createElement('option');
    opt.value = ch.id;
    opt.textContent = ch.displayMetadata?.name ?? ch.id;
    channelSel.appendChild(opt);
    if (ch.id === 'Green') channelSel.value = 'Green';
  }

  // Auto-join Green
  if (channelSel.value) {
    await joinChannel(channelSel.value);
  }
} catch (e) {
  setStatus('CDA unavailable', 'error');
  addLog('✗', `Connection failed: ${e.message}`);
}

async function joinChannel(channelId) {
  if (!fdc3 || !channelId) return;
  try {
    await fdc3.joinUserChannel(channelId);
    currentChannel = channelId;
    chanInd.textContent = `● ${channelId}`;
    chanInd.style.display = 'inline';
    chanInd.style.color = 'var(--green)';
    addLog('✓', `Joined channel [${channelId}]`);
  } catch (e) {
    addLog('✗', `Join failed: ${e.message}`);
  }
}

joinBtn.addEventListener('click', () => {
  joinChannel(channelSel.value);
});

// ── Button event delegation ──────────────────────────────────────────────────

ratesBody.addEventListener('click', async (e) => {
  const btn = e.target.closest('[data-action]');
  if (!btn || !fdc3) return;

  const sym    = btn.dataset.sym;
  const action = btn.dataset.action;
  const [base, quote] = sym.split('/');

  const context = {
    type: 'fdc3.instrument',
    id: {
      ticker:     sym,
      BBG:        sym.replace('/', ''),
      RIC:        sym.replace('/', '='),
    },
    name:         sym,
    product:      { currency: { id: { CURRENCY: quote } } },
    market: {
      bid: rates[sym].bid,
      ask: rates[sym].ask,
      mid: rates[sym].mid,
    },
  };

  if (action === 'broadcast') {
    if (!currentChannel) {
      addLog('✗', 'Not joined to any channel — pick one above');
      return;
    }
    try {
      await fdc3.broadcast(context);
      addLog('✓', `Broadcast [${sym}]  bid=${rates[sym].bid}  ask=${rates[sym].ask}`, true);
    } catch (e) {
      addLog('✗', `Broadcast error: ${e.message}`);
    }
  }

  if (action === 'intent') {
    try {
      const resolution = await fdc3.raiseIntent('ViewChart', context);
      addLog('✓', `ViewChart [${sym}] → handler: ${resolution.source?.appId ?? 'unknown'}`, true);
    } catch (e) {
      addLog('✗', `ViewChart failed: ${e.message}`);
    }
  }
});
</script>

</body>
</html>
