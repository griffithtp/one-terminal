#[tauri::command]
fn cda_open_app_directory(cfg: State<'_, AgentConfig>) -> Result<(), String> {
    tauri_plugin_opener::open_url(&cfg.app_directory_url, None::<&str>)
        .map_err(|e| format!("Failed to open App Directory: {e}"))
}

/// Return the current in-memory App Directory snapshot.
#[tauri::command]
async fn cda_list_app_directory(
    app_dir_cache: State<'_, AppDirectoryCache>,
) -> Result<Vec<AppRecord>, String> {
    Ok(app_dir_cache.list_all().await)
}

/// Trigger a fresh fetch from the App Directory service and return the count.
/// Also rebuilds the tray "Launch App" submenu so it reflects the updated list.
#[tauri::command]
async fn cda_refresh_app_directory(
    app_dir_cache: State<'_, AppDirectoryCache>,
    app: AppHandle,
) -> Result<usize, String> {
    let count = app_dir_cache.refresh().await?;
    if let Ok(menu) = build_tray_menu(&app).await {
        if let Some(tray) = app.tray_by_id("main") {
            let _ = tray.set_menu(Some(menu));
        }
    }
    Ok(count)
}

/// Open an app from the App Directory.
/// `onlineNative` apps open in a Tauri WebView container (respecting any
/// engine binding declared in the app's directory record); all other types
/// use the system browser.
/// `engine_override` is debug-only: in release builds it is silently ignored
/// so dev-only UI state can't influence production launch decisions.
#[allow(clippy::too_many_arguments)]
#[tauri::command]
async fn cda_launch_app(
    app_id: String,
    app_url: String,
    app_type: String,
    app_title: Option<String>,
    engine_override: Option<engines::EngineBinding>,
    app_dir_cache: State<'_, AppDirectoryCache>,
    engine_catalog: State<'_, EngineCatalogClient>,
    engine_store: State<'_, EngineRuntimeStore>,
    app: AppHandle,
) -> Result<(), String> {
    use engines::router::{plan_launch, resolve_binding, LaunchContext};

    if app_type != "onlineNative" {
        return open_with_os(&app, &app_id, &app_url);
    }

    // Focus an existing standalone window for this app if we already opened one.
    let label = format!(
        "app-{}",
        app_id.replace(|c: char| !c.is_alphanumeric() && c != '-', "-")
    );
    if let Some(win) = app.get_webview_window(&label) {
        win.set_focus()
            .map_err(|e| format!("Failed to focus window: {e}"))?;
        return Ok(());
    }

    // Prefer the cached App Directory record (it has engine_bindings); fall
    // back to a synthesized record from the UI's args so a missing cache
    // entry doesn't block launch.
    let records = app_dir_cache.list_all().await;
    let appd_owned;
    let appd: &AppRecord = match records.iter().find(|r| r.app_id == app_id) {
        Some(r) => r,
        None => {
            appd_owned = AppRecord {
                app_id: app_id.clone(),
                app_type: app_type.clone(),
                title: app_title.clone(),
                details: Some(app_dir::AppDetails {
                    url: Some(app_url.clone()),
                }),
                ..Default::default()
            };
            &appd_owned
        }
    };

    // Debug-only override > AppD binding > default.
    #[cfg(debug_assertions)]
    let effective_binding = engine_override.or_else(|| resolve_binding(appd));
    #[cfg(not(debug_assertions))]
    let effective_binding = {
        let _ = engine_override;
        resolve_binding(appd)
    };

    // Resolve → ensure → plan.
    let installed = if let Some(binding) = effective_binding {
        let snapshot = engine_catalog.snapshot().await;
        Some(engine_store.ensure(&binding, &snapshot, &app).await?)
    } else {
        None
    };

    let manifests = app.state::<EngineRuntimeStore>().plugins().to_vec();
    let plan = plan_launch(
        appd,
        &LaunchContext::Standalone,
        installed.as_ref(),
        &manifests,
    )?;
    execute_plan(&app, &label, &app_id, plan).await
}

/// Longest app-derived string (window label) recorded on a span: app ids come
/// from the App Directory, which accepts unauthenticated writes.
const UNTRUSTED_ATTR_CHARS: usize = 128;

/// Carry out a [`LaunchPlan`] in an `app.launch` span (a child of the FDC3
/// request that asked for it, if any), recording launch metrics. Spawned
/// processes get the span as `TRACEPARENT`.
async fn execute_plan(
    app: &AppHandle,
    label: &str,
    app_id: &str,
    plan: engines::router::LaunchPlan,
) -> Result<(), String> {
    use engines::router::LaunchPlan;
    use tracing::Instrument;

    let kind = match &plan {
        LaunchPlan::InProcessWebview { .. } => "in_process",
        LaunchPlan::SpawnTauriHost { .. } => "tauri_host",
        LaunchPlan::SpawnElectronHost { .. } => "electron_host",
        LaunchPlan::SpawnBinary { .. } => "plugin_binary",
    };
    let span = tracing::info_span!(
        target: ot_telemetry::SPAN_TARGET,
        "app.launch",
        ot.launch.kind = kind,
        ot.window = %ot_telemetry::redact::clip(label, UNTRUSTED_ATTR_CHARS)
    );
    let started = std::time::Instant::now();
    let result = run_plan(app, label, app_id, plan).instrument(span).await;
    metrics::launches().record(kind, result.is_ok(), started);
    result
}

/// Open in-process, spawn the pinned-WebView2 host, the Electron host or a
/// plugin binary. Framework windows and hosts get a widget telemetry token
/// for `label`; plugin binaries don't.
async fn run_plan(
    app: &AppHandle,
    label: &str,
    app_id: &str,
    plan: engines::router::LaunchPlan,
) -> Result<(), String> {
    use engines::router::LaunchPlan;
    use ot_core::electron_host::ElectronCommand;
    use ot_telemetry::propagation::{inject_env, ChildKind};

    let endpoint = app.state::<ot_telemetry::ingress::WidgetEndpoint>();
    // Any FDC3 client can ask for a launch (the bus doesn't authenticate
    // them yet): cap windows and processes per app and in total. The slot is
    // held for the window's or process's lifetime; an early error drops it.
    let hosts = app.state::<HostRegistry>();
    let slot = hosts.reserve(app_id)?;

    match plan {
        LaunchPlan::InProcessWebview { url, title } => {
            // `plan_launch` already checked the URL; check again here so any
            // other way of building a plan gets the same policy.
            let parsed = ot_core::widget_url::parse_widget_url(&url)
                .map_err(|e| format!("Invalid URL: {e}"))?;
            // Debug builds serve the dashboard from the dev server, which
            // Tauri then treats as a local origin (with IPC).
            let dev_origin = cfg!(debug_assertions)
                .then(|| app.config().build.dev_url.as_ref().map(|u| u.origin()))
                .flatten();
            let is_dev = move |u: &tauri::Url| dev_origin.as_ref() == Some(&u.origin());
            if is_dev(&parsed) {
                return Err("Invalid URL: the Desktop Agent's dev server origin".into());
            }
            let window =
                tauri::WebviewWindowBuilder::new(app, label, tauri::WebviewUrl::External(parsed))
                    .initialization_script(endpoint.init_script(label, Some(app_id)))
                    // The page may not navigate itself to a local origin (the
                    // agent's own, a custom scheme, the dev server) or `file:`.
                    .on_navigation(move |u| {
                        ot_core::widget_url::is_allowed_navigation(u) && !is_dev(u)
                    })
                    .title(title)
                    .inner_size(1280.0, 800.0)
                    .build()
                    .map_err(|e| format!("Failed to open WebView: {e}"))?;
            let slot = std::sync::Mutex::new(Some(slot));
            window.on_window_event(move |event| {
                if matches!(event, tauri::WindowEvent::Destroyed) {
                    slot.lock().unwrap().take();
                }
            });
            Ok(())
        }
        LaunchPlan::SpawnTauriHost {
            runtime_folder,
            url,
            title,
        } => {
            let host_bin = locate_host_binary()?;
            let mut cmd = std::process::Command::new(&host_bin);
            cmd.env("OT_APP_ID", label)
                .env("OT_URL", &url)
                .env("OT_TITLE", &title);
            if let Some(folder) = runtime_folder {
                cmd.env("WEBVIEW2_BROWSER_EXECUTABLE_FOLDER", folder);
            }
            inject_env(&mut cmd, ChildKind::LogsOnly);
            endpoint.configure_host(&mut cmd, label, Some(app_id));
            let child = cmd
                .spawn()
                .map_err(|e| format!("Failed to spawn {}: {e}", host_bin.display()))?;
            hosts.track(child, slot);
            Ok(())
        }
        LaunchPlan::SpawnElectronHost {
            binding,
            url,
            title,
        } => {
            // The shared launcher locates the electron-host shell folder
            // (OT_ELECTRON_HOST_OVERRIDE in dev, sibling-of-exe in release)
            // and the Electron binary (OT_ELECTRON_BIN, catalog cache, or
            // the shell's own node_modules from `npm install`).
            let cache_root = ot_core::engine::default_cache_root();
            let child = ot_core::electron_host::spawn_electron_app_with(
                &binding,
                &cache_root,
                label,
                &url,
                &title,
                |cmd, step| {
                    inject_env(cmd, ChildKind::LogsOnly);
                    if step == ElectronCommand::Host {
                        endpoint.configure_host(cmd, label, Some(app_id));
                    }
                },
            )?;
            hosts.track(child, slot);
            Ok(())
        }
        LaunchPlan::SpawnBinary { binary, env_vars } => {
            // `binary` is an absolute path inside the plugin's folder, so no
            // `PATH` lookup happens; run it from that folder so relative
            // lookups (config, DLLs on Windows) stay inside it too.
            let mut cmd = std::process::Command::new(&binary);
            if let Some(dir) = binary.parent() {
                cmd.current_dir(dir);
            }
            for (k, v) in env_vars {
                cmd.env(k, v);
            }
            // Third-party code: trace context only, no telemetry credentials.
            inject_env(&mut cmd, ChildKind::Untrusted);
            let child = cmd
                .spawn()
                .map_err(|e| format!("Failed to spawn plugin binary {}: {e}", binary.display()))?;
            hosts.track(child, slot);
            Ok(())
        }
    }
}

/// Find the `tauri-webview-host` binary. Honors `OT_HOST_BINARY` for dev
/// overrides; otherwise looks next to the currently-running desktop-agent binary.
fn locate_host_binary() -> Result<std::path::PathBuf, String> {
    if let Ok(path) = std::env::var("OT_HOST_BINARY") {
        return Ok(std::path::PathBuf::from(path));
    }
    let exe = std::env::current_exe().map_err(|e| format!("current_exe: {e}"))?;
    let dir = exe
        .parent()
        .ok_or_else(|| "exe has no parent dir".to_string())?;
    let name = if cfg!(windows) {
        "tauri-webview-host.exe"
    } else {
        "tauri-webview-host"
    };
    let candidate = dir.join(name);
    if !candidate.exists() {
        return Err(format!(
            "tauri-webview-host not found at {} — build it (`cargo build -p tauri-webview-host`) or set OT_HOST_BINARY",
            candidate.display()
        ));
    }
    Ok(candidate)
}

/// Find the `one-terminal` binary. Honors `OT_WM_BINARY` for dev
/// overrides; otherwise looks next to the currently-running desktop-agent binary.
fn locate_wm_binary() -> Result<std::path::PathBuf, String> {
    if let Ok(path) = std::env::var("OT_WM_BINARY") {
        return Ok(std::path::PathBuf::from(path));
    }
    let exe = std::env::current_exe().map_err(|e| format!("current_exe: {e}"))?;
    let dir = exe
        .parent()
        .ok_or_else(|| "exe has no parent dir".to_string())?;
    let name = if cfg!(windows) {
        "one-terminal.exe"
    } else {
        "one-terminal"
    };
    let candidate = dir.join(name);
    if !candidate.exists() {
        return Err(format!(
            "one-terminal not found at {} — build it (`cargo build -p one-terminal`) or set OT_WM_BINARY",
            candidate.display()
        ));
    }
    Ok(candidate)
}

/// Command to run `one-terminal`. `OT_SPAWNED_BY_AGENT` tells a dev build
/// it's one of this agent's per-Terminal processes, so it exits with its
/// last window like a release build (rather than staying up the way
/// `npm run dev:terminal` does).
fn wm_command(bin: &std::path::Path) -> std::process::Command {
    let mut cmd = std::process::Command::new(bin);
    cmd.env("OT_SPAWNED_BY_AGENT", "1");
    ot_telemetry::propagation::inject_env(
        &mut cmd,
        ot_telemetry::propagation::ChildKind::Exporting,
    );
    cmd
}

/// Spawn a Window Manager instance that restores every previously saved
/// Terminal window in one process. Called once at Desktop Agent startup.
fn spawn_wm_restore(registry: &TerminalRegistry) {
    match locate_wm_binary() {
        Ok(bin) => match wm_command(&bin).spawn() {
            Ok(child) => registry.track(child),
            Err(e) => tracing::error!("Failed to spawn window-manager: {e}"),
        },
        Err(e) => tracing::error!("{e}"),
    }
}

/// Spawn a Window Manager instance with one new, blank Terminal window (no
/// dashboard tabs, no restored windows). Called from the launcher's "Open"
/// and the tray's "Open New Terminal", so neither ever shows the dashboards
/// another Terminal has open.
fn spawn_wm_new_terminal(registry: &TerminalRegistry) {
    match locate_wm_binary() {
        Ok(bin) => match wm_command(&bin).env("OT_NEW_TERMINAL", "1").spawn() {
            Ok(child) => registry.track(child),
            Err(e) => tracing::error!("Failed to spawn new Terminal: {e}"),
        },
        Err(e) => tracing::error!("{e}"),
    }
}

// ── Tray helpers ───────────────────────────────────────────────────────────────

/// Build the full tray context menu from the current App Directory cache snapshot.
async fn build_tray_menu(app: &AppHandle) -> tauri::Result<tauri::menu::Menu<tauri::Wry>> {
    let apps = app.state::<AppDirectoryCache>().list_all().await;

    let open_item = MenuItemBuilder::with_id("open", "Open CDA").build(app)?;
    let terminal_item = MenuItemBuilder::with_id("terminal", "Open New Terminal").build(app)?;
    let exit_item = MenuItemBuilder::with_id("exit", "Exit").build(app)?;

    let mut sub = SubmenuBuilder::new(app, "Launch App");
    if apps.is_empty() {
        let placeholder = MenuItemBuilder::with_id("no-apps", "No apps available")
            .enabled(false)
            .build(app)?;
        sub = sub.item(&placeholder);
    } else {
        for record in &apps {
            let item = MenuItemBuilder::with_id(
                format!("launch:{}", record.app_id),
                record.display_title(),
            )
            .build(app)?;
            sub = sub.item(&item);
        }
    }
    let apps_sub = sub.build()?;

    MenuBuilder::new(app)
        .item(&open_item)
        .item(&terminal_item)
        .item(&apps_sub)
        .separator()
        .item(&exit_item)
        .build()
}

/// Launch an app by its App Directory ID, reusing an existing window if one is open.
async fn launch_app_from_tray(app: AppHandle, app_id: String) {
    use engines::router::{plan_launch, resolve_binding, LaunchContext};

    let apps = app.state::<AppDirectoryCache>().list_all().await;
    let Some(record) = apps.into_iter().find(|r| r.app_id == app_id) else {
        tracing::warn!("App '{app_id}' not found in directory");
        return;
    };

    let label = format!(
        "app-{}",
        app_id.replace(|c: char| !c.is_alphanumeric() && c != '-', "-"),
    );
    if let Some(win) = app.get_webview_window(&label) {
        let _ = win.set_focus();
        return;
    }

    let effective_binding = resolve_binding(&record);
    let installed = if let Some(binding) = effective_binding {
        let snapshot = app.state::<EngineCatalogClient>().snapshot().await;
        match app
            .state::<EngineRuntimeStore>()
            .ensure(&binding, &snapshot, &app)
            .await
        {
            Ok(e) => Some(e),
            Err(e) => {
                tracing::error!("Engine ensure failed for '{app_id}': {e}");
                return;
            }
        }
    } else {
        None
    };

    let manifests = app.state::<EngineRuntimeStore>().plugins().to_vec();
    match plan_launch(
        &record,
        &LaunchContext::Standalone,
        installed.as_ref(),
        &manifests,
    ) {
        Ok(plan) => {
            if let Err(e) = execute_plan(&app, &label, &app_id, plan).await {
                tracing::error!("Launch failed for '{app_id}': {e}");
            }
        }
        Err(e) => tracing::error!("Plan failed for '{app_id}': {e}"),
    }
}

// ── App entry point ────────────────────────────────────────────────────────────

/// When `OT_ELECTRON_HOST_OVERRIDE` is set, probe both the shell directory and
/// the Electron binary so the user gets an actionable warning at startup
/// instead of a cryptic error when they first try to launch an Electron app.
fn validate_electron_override() {
    let Ok(raw) = std::env::var("OT_ELECTRON_HOST_OVERRIDE") else {
        return;
    };

    // ── Shell directory check ──────────────────────────────────────────────
    let shell = {
        let path = std::path::PathBuf::from(&raw);
        if path.is_dir() && path.join("main.js").is_file() {
            path
        } else {
            tracing::warn!(
                "OT_ELECTRON_HOST_OVERRIDE={raw} is not a valid \
                 electron-host directory (expected main.js inside)\n  \
                 Fix: run `npm run setup:electron-host` from the workspace root, then retry."
            );
            return;
        }
    };

    // ── Electron binary check ──────────────────────────────────────────────
    let cache_root = ot_core::engine::default_cache_root();
    let probe = ot_core::engine::EngineBinding {
        family: ot_core::engine::EngineFamily::Electron,
        version: "system".to_string(),
    };
    if let Err(msg) = ot_core::electron_host::locate_electron_binary(&probe, &cache_root, &shell) {
        tracing::warn!("Electron binary not available — {msg}");
    }
}

#[cfg_attr(mobile, tauri::mobile_entry_point)]
pub fn run() {
    let (cfg, config_report) = AgentConfig::load_quiet();
    let resolved = ot_telemetry::resolve(&cfg.telemetry, "desktop-agent", &|key| {
        std::env::var(key).ok()
    });
    let mut telemetry = ot_telemetry::init(&resolved, env!("CARGO_PKG_VERSION"));
    telemetry.install_panic_hook();
    config_report.log();

    if let Err(msg) = cfg.ports.check_availability() {
        tracing::error!("{msg}");
        telemetry.shutdown();
        std::process::exit(1);
    }

    validate_electron_override();

    let app_dir_cache = AppDirectoryCache::new(&cfg.app_directory_url);
    let engine_catalog = EngineCatalogClient::new(&cfg.engine_catalog_url);

    // `process.startup` covers `build` and `setup`: Tauri runs `setup` inside
    // `App::run`, so the setup closure holds a clone; the span ends when setup
    // returns. Anything setup spawns (e.g. restored Terminals) gets it as
    // TRACEPARENT.
    // Widget telemetry endpoint for the windows and hosts this agent opens:
    // bound now so its URL is known before any launch; served from setup.
    let (widget_endpoint, widget_server) =
        ot_telemetry::ingress::WidgetEndpoint::start(cfg.telemetry.widgets.enabled);

    let startup = telemetry.startup_span();
    let startup_setup = startup.clone();
    let app = startup.in_scope(|| {
        tauri::Builder::default()
            .manage(app_dir_cache.clone())
            // After telemetry init, so the relay's drop counter uses the real meter.
            .manage(ot_telemetry::relay::Relay::new())
            .manage(widget_endpoint)
            .manage(engine_catalog.clone())
            .manage(cfg.clone())
            .manage(TerminalRegistry::default())
            .manage(HostRegistry::default())
            .setup(move |app| {
                let _startup = startup_setup.enter();
                if let Some(server) = widget_server {
                    tauri::async_runtime::spawn(server.run());
                }
                let adc = app.state::<AppDirectoryCache>().inner().clone();
                let app_handle = app.handle().clone();
                let ports = app.state::<AgentConfig>().ports.clone();

                // Engine runtime cache lives at the shared cross-process location
                // so the one-terminal can find runtimes installed by desktop-agent.
                let engine_root = ot_core::engine::default_cache_root();
                std::fs::create_dir_all(&engine_root)
                    .map_err(|e| format!("create engine root {}: {e}", engine_root.display()))?;
                app.manage(EngineRuntimeStore::new(engine_root));

                let ec = app.state::<EngineCatalogClient>().inner().clone();

                // In-process App Directory server. Bound to app_directory_url's port so
                // the existing AppDirectoryCache/EngineCatalogClient reqwest clients
                // below talk to it over loopback exactly as they would to a remote
                // instance. Skipped
                // when OT_APPD_EMBEDDED=0 (pointing OT_APP_DIR_URL at a remote/hosted
                // App Directory instead) or when the port is already taken by
                // something else (e.g. a dev-mode `npm run dev:app-directory`).
                let appd_cfg = app.state::<AgentConfig>().inner().clone();
                if appd_cfg.appd_embedded {
                    let port = config::port_from_url(&appd_cfg.app_directory_url);
                    tauri::async_runtime::spawn(async move {
                        match tokio::net::TcpListener::bind(("127.0.0.1", port)).await {
                            Ok(listener) => {
                                tracing::info!(
                                    "App Directory (embedded) listening on 127.0.0.1:{port}"
                                );
                                let router = ot_appdirectory::router_with_ui(
                                    ot_appdirectory::AppStore::new(),
                                );
                                if let Err(e) = axum::serve(listener, router).await {
                                    tracing::error!("App Directory server error: {e}");
                                }
                            }
                            Err(e) => {
                                tracing::warn!(
                                "App Directory (embedded) skipped — port {port} unavailable: {e}"
                            );
                            }
                        }
                    });
                }

                // FDC3 broker, seeded with user channels from config, and the
                // WebSocket server browser apps reach it through.
                let broker = Broker::new(Arc::new(TauriEvents(app_handle.clone())));
                for ch in &app.state::<AgentConfig>().user_channels {
                    broker.add_user_channel(&ch.id, &ch.display_name, &ch.color);
                }
                app.manage(broker.clone());
                tauri::async_runtime::spawn(fdc3_bus::start(
                    ports.fdc3_bus,
                    broker,
                    Arc::new(TauriBusHost(app_handle.clone())),
                ));

                let app_handle_tray = app_handle;

                // Initial App Directory fetch (non-fatal if the service is not running).
                tauri::async_runtime::spawn(async move {
                    match adc.refresh().await {
                        Ok(n) => {
                            tracing::info!("App Directory: {n} app(s) loaded at startup");
                            if let Ok(menu) = build_tray_menu(&app_handle_tray).await {
                                if let Some(tray) = app_handle_tray.tray_by_id("main") {
                                    let _ = tray.set_menu(Some(menu));
                                }
                            }
                        }
                        Err(e) => tracing::warn!("App Directory unavailable at startup: {e}"),
                    }
                });

                // Initial engine catalog fetch (same non-fatal policy).
                tauri::async_runtime::spawn(async move {
                    match ec.refresh().await {
                        Ok(n) => {
                            tracing::info!("Engine catalog: {n} entry/entries loaded at startup");
                        }
                        Err(e) => tracing::warn!("Engine catalog unavailable at startup: {e}"),
                    }
                });

                // Restore the Terminal windows that were open when the Desktop
                // Agent last quit (each window's session is deleted when the user
                // closes it, and "Quit and discard" deletes them all). With none
                // saved, no Terminal opens until the user clicks "Open" on the
                // launcher's Terminal card (cda_open_terminal) or "Open New
                // Terminal" in the tray menu, both of which open a blank one.
                if has_saved_terminals(app.handle()) {
                    spawn_wm_restore(app.state::<TerminalRegistry>().inner());
                }

                // ── System tray ────────────────────────────────────────────────────
                // Initial menu: apps list is empty until the App Directory fetch completes.
                let open_item = MenuItemBuilder::with_id("open", "Open CDA").build(app)?;
                let terminal_item =
                    MenuItemBuilder::with_id("terminal", "Open New Terminal").build(app)?;
                let exit_item = MenuItemBuilder::with_id("exit", "Exit").build(app)?;
                let placeholder = MenuItemBuilder::with_id("no-apps", "No apps available")
                    .enabled(false)
                    .build(app)?;
                let apps_sub = SubmenuBuilder::new(app, "Launch App")
                    .item(&placeholder)
                    .build()?;
                let init_menu = MenuBuilder::new(app)
                    .item(&open_item)
                    .item(&terminal_item)
                    .item(&apps_sub)
                    .separator()
                    .item(&exit_item)
                    .build()?;

                let _tray = TrayIconBuilder::with_id("main")
                    .icon(app.default_window_icon().unwrap().clone())
                    .icon_as_template(true)
                    .menu(&init_menu)
                    .tooltip("<%= displayName %> Desktop Agent")
                    .on_menu_event(|app, event| match event.id.as_ref() {
                        "open" => {
                            if let Some(w) = app.get_webview_window("desktop-agent-dashboard") {
                                let _ = w.show();
                                let _ = w.set_focus();
                            }
                        }
                        "terminal" => {
                            spawn_wm_new_terminal(app.state::<TerminalRegistry>().inner());
                        }
                        "exit" => {
                            // Show the dashboard window and ask the user whether to
                            // save or discard Terminal state before quitting.
                            if let Some(w) = app.get_webview_window("desktop-agent-dashboard") {
                                let _ = w.show();
                                let _ = w.unminimize();
                                let _ = w.set_focus();
                                let _ = tauri::Emitter::emit(app, "cda:quit-requested", ());
                            } else {
                                // No dashboard window (shouldn't happen), fall back.
                                app.exit(0);
                            }
                        }
                        id if id.starts_with("launch:") => {
                            let app_id = id.trim_start_matches("launch:").to_string();
                            let app_clone = app.clone();
                            tauri::async_runtime::spawn(launch_app_from_tray(app_clone, app_id));
                        }
                        _ => {}
                    })
                    .on_tray_icon_event(|tray, event| {
                        if let TrayIconEvent::Click {
                            button: MouseButton::Left,
                            button_state: MouseButtonState::Up,
                            ..
                        } = event
                        {
                            let app = tray.app_handle();
                            if let Some(w) = app.get_webview_window("desktop-agent-dashboard") {
                                let _ = w.show();
                                let _ = w.set_focus();
                            }
                        }
                    })
                    .build(app)?;

                Ok(())
            })
            .on_window_event(|window, event| {
                if window.label() == "desktop-agent-dashboard" {
                    if let tauri::WindowEvent::CloseRequested { api, .. } = event {
                        api.prevent_close();
                        let _ = window.hide();
                    }
                }
            })
            .plugin(tauri_plugin_opener::init())
            .invoke_handler(tauri::generate_handler![
                cda_list_connections,
                cda_list_channels,
                cda_disconnect_spoke,
                cda_broadcast_from_dashboard,
                cda_list_intent_handlers,
                cda_raise_intent_from_dashboard,
                cda_open_terminal,
                cda_get_app_dir_url,
                cda_open_app_directory,
                cda_quit,
                cda_quit_discard,
                cda_list_app_directory,
                cda_refresh_app_directory,
                cda_launch_app,
                engines::commands::engine_catalog,
                engines::commands::engine_refresh_catalog,
                engines::commands::engine_list_installed,
                engines::commands::engine_ensure,
                telemetry_cmd::cda_telemetry_log,
            ])
            .build(tauri::generate_context!())
            .expect("error while building <%= displayName %> Desktop Agent")
    });
    drop(startup);
    app.run(move |app, event| {
        if let tauri::RunEvent::Exit = event {
            kill_app_hosts(app);
            telemetry.shutdown();
        }
    });
}
