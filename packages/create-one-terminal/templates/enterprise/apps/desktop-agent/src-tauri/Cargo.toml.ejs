[package]
name = "desktop-agent"
version = "0.1.0"
description = "<%= displayName %> Desktop Agent — FDC3 3.0 centralised hub for all apps"
authors = ["one-terminal"]
edition = "2021"
publish = false

[lib]
name = "<%= snakeWorkspaceName %>_agent_lib"
crate-type = ["staticlib", "cdylib", "rlib"]

[build-dependencies]
tauri-build = { version = "2", features = [] }

[dependencies]
tauri               = { workspace = true, features = ["tray-icon"] }
tauri-plugin-opener = { workspace = true }
serde               = { workspace = true }
serde_json          = { workspace = true }
tokio               = { workspace = true }
rand                = { workspace = true }
dashmap             = { workspace = true }
axum                = { workspace = true }
tower-http          = { workspace = true }
futures-util        = { workspace = true }
reqwest             = { workspace = true }
sha2                = { workspace = true }
hex                 = { workspace = true }
zip                 = { workspace = true }
ot-core             = { workspace = true }
ot-appdirectory     = { workspace = true }
ot-telemetry        = { workspace = true, features = ["otlp"] }
tracing             = { workspace = true }

[dev-dependencies]
# The fdc3_bus_harness example logs to stdout, where the contract tests read it.
tracing-subscriber  = { workspace = true }

[lints]
workspace = true
