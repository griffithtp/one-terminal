{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "<%= workspaceName %>-agent",
  "version": "0.1.0",
  "identifier": "<%= tauriIdentifier %>.agent",
  "build": {
    "beforeDevCommand": "npm -w @<%= orgScope %>/desktop-agent run dev",
    "devUrl": "http://localhost:<%= agentDevPort %>",
    "beforeBuildCommand": "npm -w @<%= orgScope %>/desktop-agent run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "desktop-agent-dashboard",
        "title": "<%= displayName %> Desktop Agent",
        "width": 1100,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/agent.config.json": "resources/agent.config.json",
      "resources/plugins/**/*": "resources/plugins",
      "../../one-terminal/src-tauri/resources/widgets.config.json": "resources/widgets.config.json"
    },
    "externalBin": ["binaries/one-terminal"]
  }
}
