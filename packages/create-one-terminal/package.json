{
  "name": "create-one-terminal",
  "version": "0.1.0",
  "description": "Scaffold a new OneTerminal workspace",
  "type": "module",
  "bin": {
    "create-one-terminal": "./dist/index.js"
  },
  "files": [
    "dist",
    "versions.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"import('node:fs').then(fs => fs.cpSync('src/templates', 'dist/templates', { recursive: true }))\" 2>/dev/null || true",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "ejs": "^3.1.10",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.3.4"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^22",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=18"
  }
}
