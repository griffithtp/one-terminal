{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "one-terminal",
  "version": "0.1.0",
  "identifier": "com.one-terminal.one-terminal",
  "build": {
    "beforeDevCommand": "npm -w @one-terminal/one-terminal run dev:tauri",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm -w @one-terminal/one-terminal run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/widgets.config.json"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
