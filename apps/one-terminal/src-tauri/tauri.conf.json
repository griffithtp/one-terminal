{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "one-terminal",
  "version": "0.1.0",
  "identifier": "com.one-terminal.one-terminal",
  "build": {
    "beforeDevCommand": "npm -w @one-terminal/one-terminal run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm -w @one-terminal/one-terminal run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/widgets.config.json"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
