{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Terminal chrome, overlay and popout-chrome webviews: only the window and event APIs their JS calls. Webviews and windows are created from Rust, which needs no capability.",
  "windows": ["terminal-main-chrome", "terminal-main-overlay", "terminal-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:event:allow-emit",
    "core:event:allow-emit-to",
    "core:event:allow-listen"
  ]
}
