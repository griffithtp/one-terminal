# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
apps/*/dist/
packages/*/dist/
# Exception: tauri-webview-host ships a stub dist/ that satisfies Tauri's
# frontendDist validation at compile time. It is source-of-truth, not a
# build artifact, so it must stay tracked in both the framework and any
# scaffolded workspaces (this .gitignore copies through verbatim).
!apps/tauri-webview-host/dist/
!apps/tauri-webview-host/dist/**

# Local development
.claude/settings.local.json
local/
*.local

# Scaffolder build output
packages/create-one-terminal/dist/

# Upgrade tool backup snapshots
.one-terminal/upgrade-backup-*/

# Tauri generated files
apps/*/src-tauri/gen/
target/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
