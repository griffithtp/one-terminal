{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "npm run format:check",
            "statusMessage": "Checking formatting before push...",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-generated.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:v2.tauri.app)",
      "WebFetch(domain:tauri.app)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:crates.io)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run typecheck:scripts)",
      "Bash(npm run test:terminal)",
      "Bash(npm run test:fdc3-plugin)",
      "Bash(npm run test:scripts)",
      "Bash(npm run check:docs)",
      "Bash(npm run check:ai-drift)",
      "Bash(npm run check-template-drift)",
      "Bash(npm run check:bundle-size)",
      "Bash(npm run sync:ai)",
      "Bash(cargo check --workspace)",
      "Bash(cargo clippy --workspace --all-targets -- -D warnings)",
      "Bash(curl -sf http://localhost:3005/health)",
      "Bash(python3 -m json.tool)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.npmrc)",
      "Read(~/.cargo/credentials*)",
      "Read(~/.tauri/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(npm publish*)",
      "Bash(cargo publish*)"
    ]
  }
}
